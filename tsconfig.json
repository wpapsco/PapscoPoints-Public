{
    "compilerOptions": {
        "target": "es2017",
        "moduleResolution": "node",
        "outDir": "./express/",
        "rootDir": "src/",
        "module": "commonjs",
        "removeComments": true,
        "allowJs": true,
        "watch": true,
        "preserveWatchOutput": true,
        "pretty": true
    },
    "include": [
        "src/server/routes/*",
        "src/*",
        "src/server/*",
        "src/bot/*"
    ]
}