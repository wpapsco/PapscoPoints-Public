files:
  "/home/ec2-user/install-java-8.sh":
    mode: "000755"
    owner: ec2-user
    group: ec2-user
    content: |
      #!/usr/bin/env bash
      yum -y install java-1.8.0
      yum -y remove java-1.7.0-openjdk
commands:
  execute-install-java-8-script:
    command: ./install-java-8.sh
    cwd: /home/ec2-user